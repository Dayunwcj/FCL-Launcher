<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  :app 的清单 —— 桌面入口在这里，FCL 那边的权限/组件由库清单合并进来
  ============================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 存储/网络等权限由 FCL 的库清单提供，这里不重复声明 -->

    <application
        android:name="com.doubao.mclauncher.App"
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="豆包MC启动器"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoldCraftLauncher"
        android:usesCleartextTraffic="true"
        tools:ignore="DiscouragedApi,ScopedStorage">

        <!-- 我们的入口：Compose 首页 -->
        <activity
            android:name="com.doubao.mclauncher.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:exported="true"
            android:theme="@style/Theme.MCLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 前台服务：跑游戏时保活 -->
        <service
            android:name="com.doubao.mclauncher.launch.LaunchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
